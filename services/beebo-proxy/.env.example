# Copy to .env. Nothing in here belongs in version control.

# --- speech, via Alibaba DashScope -------------------------------------------
DASHSCOPE_API_KEY=sk-your-key-here
# ASR_MODEL=qwen3-asr-flash
# TTS_MODEL=qwen3-tts-flash
# ASR_LANGUAGE=zh
# TTS_LANGUAGE=Auto            # Auto | Chinese | English
# TTS_VOICE=Dylan              # Cherry, Ethan, Dylan, Jennifer, Ryan, ...
# TTS_MAX_CHARS=260

# --- the agent ----------------------------------------------------------------
# Where the OpenClaw gateway listens. Same machine by default.
GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
# AGENT_THINKING=off           # "off" saves about nine seconds a turn
# VOICE_SESSION_KEY=beebo

# --- what the board hears -----------------------------------------------------
# Appended to every question. The agent answers a spoken question the way it
# answers a typed one - headings, tables, emoji - and the length of the reply,
# not the speed of any service, is what makes a voice turn feel slow.
# The default is English. For a Chinese setup:
# VOICE_STYLE=\n\n[语音对话：请用口语化的一两句话回答，不要用 markdown、标题、表格、列表或表情符号。需要展开时先给结论，再问要不要细说。]
# TTS_MORE=……还有更多，要我细说吗？

# --- serving ------------------------------------------------------------------
# VOICE_PORT=18797
# Must match BEEBO_PROXY_TOKEN in the firmware, or be empty on both sides.
# RELAY_TOKEN=
# Log when each clause is sent for synthesis and when its audio goes out.
# RELAY_TRACE=1
